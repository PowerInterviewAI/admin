# MongoDB - point this at the same database backend uses.
# Server-only: never prefix these with NEXT_PUBLIC_, or the connection string ships to the browser.
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=power_interview_ai

# This dashboard's own accounts and sign-in sessions: same cluster, different database.
# Separate from MONGO_DB because these describe operators of the admin tool, not customers of the
# product - nothing in here is a Power Interview user, and backend never reads it.
# The first account to sign up becomes the admin; every one after it is a read-only guest.
ADMIN_MONGO_DB=pia_admin

# Forces the session cookie's Secure flag. Leave unset and the request's scheme decides, which is
# what keeps sign-in working over plain http on localhost and still sets the flag behind TLS.
# Set it to true only if you terminate TLS somewhere that does not send x-forwarded-proto.
# SECURE_COOKIES=true

# Only used when Node's own DNS config is broken, which breaks mongodb+srv:// URLs specifically.
# See src/server/dns.ts. Leave unset unless the default resolvers are unreachable for you.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# SMTP, for the email marketing page (/emails). Leave unset and that page renders read-only:
# the composer and preview still work, sending is disabled with the reason shown.
# Same account backend and the Python bulk sender use. For Resend, SMTP_EMAIL is the literal
# string `resend` and SMTP_PASSWORD is the API key. SMTP_PORT must be an implicit-TLS port.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_EMAIL=resend
SMTP_PASSWORD=re_your_api_key

# Envelope of every campaign. Defaults match what backend and the bulk sender already send as,
# so leaving these unset keeps marketing and transactional mail arriving from one address.
# APP_NAME=Power Interview AI
# EMAIL_FROM_ADDRESS=noreply@vectorleappulse.xyz
# EMAIL_FROM_NAME=Power Interview AI Team

# Prefills the compose page's test-send box.
EMAIL_TEST_ADDRESS=you@example.com

# Pause between recipients during a campaign, holding the run under the provider's rate limit.
# EMAIL_SEND_DELAY_MS=1000
