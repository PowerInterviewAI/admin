# MongoDB - point this at the same database backend uses
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=power_interview_ai

# API server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Comma-separated origins allowed to call this API from a browser (the Next.js dev/start server)
CORS_ORIGINS=http://localhost:3000
